{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for every app window: the main one and those opened with New Window",
  "windows": ["main", "window-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "core:webview:allow-set-webview-zoom"
  ]
}
